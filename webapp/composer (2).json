    <script>
        const isViewer = <?php echo json_encode($is_viewer); ?>;

        function toggleDevice(deviceName) {
            if (isViewer) {
                alert("Viewers cannot change settings.");
                return;
            }

            $.ajax({
                url: 'mobile_app.php',
                method: 'POST',
                data: { action: 'toggle_device', device: deviceName },
                success: function (res) {
                    if (res.status === 'success') {
                        if (navigator.vibrate) navigator.vibrate(50);
                        fetchStatus();
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function fetchStatus() {
            // Kunin ang sensor data (temperature & humidity) mula sa existing endpoint mo
            $.ajax({
                url: 'automated.php?action=get_device_status',
                method: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (!res) return;

                    if (res.exhaust_fan === 'ON') $('#badge-fan').show(); else $('#badge-fan').hide();
                    if (res.heater === 'ON') $('#badge-heater').show(); else $('#badge-heater').hide();
                    if (res.cooling_mist === 'ON') $('#badge-mist').show(); else $('#badge-mist').hide();

                    // I-update ang Temperature at Humidity sa LCD text
                    // Kung halimbawa ang variable mo sa backend ay res.temperature at res.humidity
                    let temp = res.temperature !== undefined ? parseFloat(res.temperature).toFixed(1) : '--.-';
                    let hum = res.humidity !== undefined ? parseFloat(res.humidity).toFixed(1) : '--.-';

                    // Pinapanatili ang format na parang 16x2 screen
                    $('#lcd-display').text(`TEMP: ${temp}°C\nHUM : ${hum}%`);
                }
            });
        }

        $(document).ready(function () {
            fetchStatus();
            setInterval(fetchStatus, 2000);
        });
    </script>
