<?php
session_start();
require_once 'db.php';

// Handle AJAX Requests para sa pagpindot ng mga buttons
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    header('Content-Type: application/json');

    // Para hindi mapindot ng Viewer
    if (strcasecmp($_SESSION['role'] ?? 'Viewer', 'Viewer') === 0) {
        echo json_encode(['status' => 'error', 'message' => 'Viewers cannot control devices.']);
        exit;
    }

    $action = $_POST['action'];

    if ($action === 'toggle_device') {
        $device = $_POST['device'] ?? '';

        $stmt = $conn->prepare("SELECT setting_value FROM system_settings WHERE setting_key = ?");
        $stmt->bind_param("s", $device);
        $stmt->execute();
        $res = $stmt->get_result();
        $row = $res->fetch_assoc();
        $stmt->close();

        $current_state = $row['setting_value'] ?? 'OFF';
        $new_state = ($current_state === 'ON') ? 'OFF' : 'ON';

        $update = $conn->prepare("UPDATE system_settings SET setting_value = ? WHERE setting_key = ?");
        $update->bind_param("ss", $new_state, $device);
        $update->execute();
        $update->close();

        echo json_encode(['status' => 'success', 'device' => $device, 'state' => $new_state]);
        exit;
    }
}

$settings = [];
$result = $conn->query("SELECT * FROM system_settings");
if ($result) {
    while ($row = $result->fetch_assoc()) {
        $settings[$row['setting_key']] = $row['setting_value'];
    }
}

$system_mode = $settings['system_mode'] ?? 'automatic';
$is_viewer = (strcasecmp($_SESSION['role'] ?? 'Viewer', 'Viewer') === 0);
?>
